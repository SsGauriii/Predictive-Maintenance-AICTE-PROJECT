# ============================================================
# IBM Cloud Lite Services Configuration
# ============================================================

# --- IBM Watson Machine Learning (WML) ---
IBM_WML_API_KEY=your_ibm_wml_api_key_here
IBM_WML_URL=https://us-south.ml.cloud.ibm.com
IBM_WML_INSTANCE_ID=your_wml_instance_id_here
IBM_WML_SPACE_ID=your_wml_space_id_here

# --- IBM Cloud Object Storage (COS) ---
IBM_COS_API_KEY=your_ibm_cos_api_key_here
IBM_COS_SERVICE_INSTANCE_ID=your_cos_resource_instance_id_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_AUTH_ENDPOINT=https://iam.cloud.ibm.com/oidc/token
IBM_COS_BUCKET_NAME=predictive-maintenance-bucket

# --- IBM Watson Studio Project ---
IBM_WATSON_STUDIO_PROJECT_ID=your_project_id_here

# --- IBM Cloud IAM ---
IBM_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token

# --- Dataset Configuration ---
DATASET_PATH=data/predictive_maintenance.csv

# --- Model Configuration ---
MODEL_NAME=predictive_maintenance_classifier
MODEL_VERSION=1.0
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
OUTPUT_DIR=outputs
MODEL_SAVE_PATH=models/
